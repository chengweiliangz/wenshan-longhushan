# Copy to .env. Valid settings saved by the server owner override this file.
# AI_API_KEY is server-only; never put credentials in VITE_* variables.
AI_NAME=DeepSeek
AI_ENABLED=true
AI_FORMAT=chat-completions
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
AI_AUTH_MODE=bearer
AI_JSON_MODE=true
AI_TOKEN_PARAMETER=max_tokens
AI_MAX_TOKENS=1800
AI_TIMEOUT_SECONDS=45
PORT=5173
HOST=127.0.0.1
