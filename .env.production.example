# Create .env only on the deployment host. Never upload it to Git or share it.
# SITE_DOMAIN is a public DNS hostname, without scheme, port or path.
SITE_DOMAIN=wenshan.example.com
AI_ENABLED=false
AI_API_KEY=
AI_NAME=DeepSeek
AI_FORMAT=chat-completions
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
AI_AUTH_MODE=bearer
AI_JSON_MODE=true
AI_TOKEN_PARAMETER=max_tokens
AI_MAX_TOKENS=1800
AI_TIMEOUT_SECONDS=45
